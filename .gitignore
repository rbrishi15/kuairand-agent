venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
~$*.docx
~$*.doc

# raw dataset — download via README, don't commit ~200MB of CSVs
data/raw/*.csv
# bonus datasets (playbook Day 3: KuaiRand-1K/-27K, ~1.2GB / ~10GB of CSVs
# renamed to the _pure filenames src/data.py expects) — never commit these
data/raw_1k/*.csv
data/raw_27k/*.csv
data/splits/*

# generated artifacts
outputs/*.csv
# smoke_test.pt specifically: regenerated by every scripts/check.sh run,
# never a real trained model — everything else in checkpoints/ IS tracked
# (56MB total across 19 files as of the ablation work; small enough for
# plain git, no Git LFS needed despite the playbook's general large-file
# guidance) so Sarthak and everyone else can pull real checkpoints
# straight from the repo instead of retraining ~35 minutes of ablations.
checkpoints/smoke_test.pt

!data/raw/.gitkeep
!data/splits/.gitkeep
!outputs/.gitkeep
